# Copie estes nomes para o Netlify: Site configuration → Environment variables.
# NÃO coloque os valores de verdade neste arquivo.

# Link de conexão do MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Nome do banco (o sistema antigo usava delta_green)
MONGODB_DB=delta_green

# Texto aleatório e longo (24+ caracteres) para assinar as sessões
JWT_SECRET=troque-por-um-texto-bem-grande-e-aleatorio

# Login do Handler (mestre)
GM_USERNAME=MESTRE KONA
GM_PASSWORD=troque-esta-senha

# Opcionais
DEFAULT_CAMPAIGNS=DELTA GREEN 0,LALUTH
SESSION_DURATION=12h
# Ficha de teste (botão "Testar com uma ficha de exemplo" e link /?demo)
DEMO_ENABLED=true
DEMO_MINUTES=60
DEMO_MAX=30
